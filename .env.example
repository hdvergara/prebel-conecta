# Copia este archivo a .env (ya está en .gitignore -- nunca lo commitees) y
# ajusta los valores. Son los parámetros de conexión y secretos que usa
# model/whatsapp_service.py para hablar con un entorno compatible con la
# WhatsApp Cloud API.
#
# Los valores de abajo son los que coinciden con un emulador local recién
# arrancado (ver whatsapp-emulator/README.md, fuera de este repo -- solo un
# auxiliar de pruebas). Para un entorno de pruebas real de Meta más adelante,
# solo cambias estos valores; model/whatsapp_service.py no necesita tocarse.

# Base de la API tipo Graph (del emulador local, o https://graph.facebook.com en Meta real)
WA_GRAPH_URL=http://localhost:4010
WA_API_VERSION=v26.0

# Identificador del número de WhatsApp del negocio (no es el número de teléfono)
WA_PHONE_NUMBER_ID=100000000000001

# Token que este servicio envía como "Authorization: Bearer ..." al enviar mensajes
WA_ACCESS_TOKEN=local-dev-token

# Debe coincidir con VERIFY_TOKEN configurado en el emulador (o en la app de Meta)
WA_VERIFY_TOKEN=prebel-conecta-dev

# Debe coincidir con APP_SECRET configurado en el emulador (o el app secret real de Meta);
# se usa para validar la firma X-Hub-Signature-256 de cada webhook entrante
WA_APP_SECRET=prebel-conecta-dev-secret

# Puerto local donde este servicio escucha /webhook
WA_SERVICE_PORT=3000
